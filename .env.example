# ==============================================================================
# Configuracion de entorno para desarrollo local.
#
#   cp .env.example .env
#
# Compose lee este archivo desde la raiz del proyecto y sustituye las
# referencias ${VARIABLE} del docker-compose.yml. Los contenedores NO reciben
# el archivo completo: cada servicio recibe solo las variables que declara su
# bloque "environment", de modo que post-service nunca ve las credenciales de
# la base de datos de auth-service.
#
# En produccion este archivo no existe. Las variables vienen de un gestor de
# secretos (Kubernetes Secrets, AWS Parameter Store, Vault).
# ==============================================================================

# ------------------------------------------------------------------ auth-service
POSTGRES_AUTH_DB=social_auth
POSTGRES_AUTH_USER=auth_service
POSTGRES_AUTH_PASSWORD=

# ------------------------------------------------------------------ post-service
POSTGRES_POSTS_DB=social_posts
POSTGRES_POSTS_USER=post_service
POSTGRES_POSTS_PASSWORD=

# --------------------------------------------------------------------------- JWT
# HS256 exige una clave de 256 bits como minimo. Generar con:
#   openssl rand -base64 48
# El mismo valor debe estar en auth-service, post-service y api-gateway: uno
# firma y los otros verifican. Si difieren, el login funciona y las
# publicaciones devuelven 401.
JWT_SECRET=
JWT_ISSUER=social-auth-service
JWT_EXPIRATION_MINUTES=60

# ---------------------------------------------------------------------- Frontend
# Todo lo que sigue viaja al navegador y es publico: se lee con F12.
# Nunca poner aqui una clave, una contrasena ni JWT_SECRET.
API_BASE_URL=/api
APP_NAME=Red Social
POSTS_PAGE_SIZE=20
SESSION_EXPIRY_WARNING_SECONDS=60

# --------------------------------------------- Puertos publicados en el anfitrion
# Solo para acceder desde tu maquina (navegador, DBeaver, Swagger individual).
# La comunicacion entre contenedores usa los puertos internos y no depende de esto.
FRONTEND_PORT=4200
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
POST_SERVICE_PORT=8082
POSTGRES_AUTH_PORT=5433
POSTGRES_POSTS_PORT=5434
