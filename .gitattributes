# Normaliza los finales de linea a LF en el repositorio. Sin esto, un archivo
# creado en Windows entra con CRLF y los scripts fallan dentro de los
# contenedores Linux con "bad interpreter: No such file or directory".
* text=auto eol=lf

# Los scripts de Windows si necesitan CRLF para ejecutarse.
*.bat text eol=crlf
*.cmd text eol=crlf

*.sh  text eol=lf
mvnw  text eol=lf

*.java  text
*.xml   text
*.sql   text
*.ts    text
*.html  text
*.scss  text

*.jar  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
